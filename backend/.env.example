# ---- Server ----
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the app (Render/Railway/Fly = 1).
# Set to 0 when running with NO proxy so clients cannot spoof X-Forwarded-For.
TRUST_PROXY=1

# ---- Database ----
# Local:   mongodb://127.0.0.1:27017/bingo
# Atlas:   mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/bingo?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/bingo

# ---- Auth ----
# REQUIRED in every environment. Must be a strong random string (>=32 chars).
# The server REFUSES to boot without it (fail-closed). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# For LOCAL DEV ONLY: set to 1 to run with an ephemeral per-process secret
# instead of providing JWT_SECRET. Never set this in production.
# ALLOW_INSECURE_JWT=1
JWT_EXPIRES_IN=2d
BCRYPT_ROUNDS=12

# ---- Email (password reset) ----
# Base URL of the FRONTEND, used to build reset links in emails.
# Defaults to the first CLIENT_ORIGIN if unset.
APP_URL=http://localhost:5173
# SMTP transport. Leave SMTP_HOST blank to run WITHOUT sending email:
# /forgot-password still succeeds uniformly (no enumeration) but nothing is
# delivered; the link is logged in dev. Set these to enable real emails.
# Works with any provider (Gmail App Password, Brevo, Mailgun, SendGrid...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0            # 1 only for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bingo Arena <no-reply@bingo-arena.local>
# How long a reset link stays valid, in ms (default 3600000 = 1 hour).
RESET_TTL_MS=3600000

# ---- Game timing (seconds) ----
SETUP_SECONDS=30
TURN_SECONDS=20
RECONNECT_GRACE_SECONDS=30
MAX_TIMEOUTS=3

# ---- Matchmaking ----
MAX_QUEUE_SIZE=5000
MAX_QUEUE_WAIT_MS=120000

# ---- Socket handshake limits ----
SOCKET_HS_WINDOW_MS=60000
SOCKET_HS_MAX_PER_IP=60
SOCKET_MAX_CONNECTIONS=20000

# ---- HTTP rate limiting ----
RATE_WINDOW_MS=60000
RATE_MAX=100
AUTH_RATE_MAX=10
