{
  "name": "ironhold-backend",
  "version": "1.0.0",
  "description": "Ironhold — week-long browser strategy/trade-war game backend (Express + Socket.IO + MongoDB)",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:integration": "jest --runInBand --detectOpenHandles",
    "lint": "echo \"(configure eslint if desired)\" && exit 0",
    "dev:local": "node scripts/dev-local.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "nodemailer": "^10.0.11",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0"
  }
}
