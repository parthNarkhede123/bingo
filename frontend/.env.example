# Base URL of the backend (REST + Socket.IO). No trailing slash.
VITE_API_URL=http://localhost:4000

# Google AdSense publisher id, e.g. ca-pub-XXXXXXXXXXXXXXXX.
# Leave blank to show non-intrusive placeholder ad slots instead.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
# Optional per-placement ad slots. Each falls back to VITE_ADSENSE_SLOT above
# when left blank, so one slot id is enough to start.
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_PLAY=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_PROFILE=
